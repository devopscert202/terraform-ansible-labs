# Every variable in this lab already has a default, so this file is optional.
# Copy it to terraform.tfvars and edit a value to see precedence in action:
# a value here overrides the variable's default. Lab 07 covers tfvars in
# detail. Never put secrets in this file.
aws_region          = "us-east-2"
vpc_cidr            = "10.0.0.0/16"
public_subnet_cidr  = "10.0.1.0/24"
private_subnet_cidr = "10.0.2.0/24"
public_subnet_az    = "us-east-2a"
private_subnet_az   = "us-east-2b"
instance_type       = "t3.micro"
instance_name       = "tf-lab03-web"
